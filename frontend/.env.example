# Copy to ".env" if you need to change these.
# Leave VITE_API_URL empty in development (Vite proxies /api to Django).
# In production set it to your backend URL, for example https://resume-api.airojgar.in
VITE_API_URL=
# Link used by the "AiRojgar" logo and "Back to AiRojgar" buttons
VITE_MAIN_SITE_URL=https://airojgar.in
